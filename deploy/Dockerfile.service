# The hosted analysis: the codec, built, behind an HTTP endpoint.
#
# The service is a transport in front of `girc-core`, so the image has to
# contain the codec. It is built here rather than copied from a registry,
# because the hosted analysis has to be the same code the repository ships and
# not a build somebody made earlier.
#
# Two stages, because the Rust toolchain is three gigabytes and the service is
# a few megabytes.

FROM rust:1.99.0-slim-trixie AS build

WORKDIR /src

# The codec and the model it uses. The model is committed, so the deployed
# predictor is the one the documents quote.
COPY crates/ crates/
COPY Cargo.toml Cargo.lock ./
COPY models/ models/

# The CLI is the only binary the service needs: it is the encode, decode and
# inspect surface, and the service shells out to it.
ARG GIRC_BUILD_JOBS=2
RUN cargo build --release --locked -p girc-cli --bin girc \
    --jobs "${GIRC_BUILD_JOBS}"

# ---------------------------------------------------------------------------

FROM debian:trixie-slim

# The application needs the Python dependencies and the compiled binary, and
# nothing else. No shell, no package manager, no root.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY apps/portal/requirements.service.txt ./requirements.txt
RUN pip3 install --no-cache-dir --break-system-packages -r requirements.txt

COPY apps/portal/girc_eval ./girc_eval
COPY models/ ./models
COPY --from=build /src/target/release/girc /usr/local/bin/girc

RUN useradd --system --uid 10001 girc \
    && chown -R girc:girc /app
USER girc

ENV PORT=8000 \
    GIRC_CLI=/usr/local/bin/girc \
    GIRC_MODEL=/app/models/girc-predictor.json
EXPOSE 8000

# Render passes PORT and expects the process to listen on it.
CMD ["python3", "-m", "girc_eval.service"]
