# The deployment's environment.
#
# Copy this to .env and fill in the values. The .env file is mode 600
# and is not in the repository: the secret it holds signs the sessions
# and the download links, so anybody holding it can mint a link to any
# artifact.
#
#   cp .env.example .env
#   chmod 600 .env
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

# The domain the portal is served on. Caddy obtains the certificate for
# it, so it has to point at this host's public address.
GIRC_DOMAIN=eval.example.invalid

# The address Caddy sends the certificate's expiry notice to.
GIRC_EMAIL=admin@example.invalid

# The database.
#
# The password must not be empty: PostgreSQL refuses to initialise
# without one, and the container's health check then fails and the
# portal never starts. The check in CI is what caught that.
GIRC_DB_NAME=girc_eval
GIRC_DB_USER=girc_eval
GIRC_DB_PASSWORD=

# The signing secret for the session cookies and the download links.
# Generate it with: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
GIRC_SECRET_KEY=

# The first administrator.
GIRC_ADMIN_EMAIL=admin@example.invalid

# The distributed sign-in rate limiter. Without these the limit is kept
# in the portal's own memory, which is enough for one process and not
# enough for two. The URL is the Upstash REST endpoint and the token is
# its bearer token.
GIRC_REDIS_URL=
GIRC_REDIS_TOKEN=

# The sign-in limit, per address: how many failed attempts are allowed
# before the address is locked out, and for how long.
GIRC_LOGIN_MAX_ATTEMPTS=10
GIRC_LOGIN_LOCKOUT_SECONDS=900
